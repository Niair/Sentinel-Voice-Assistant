# ============================================
# FRONTEND ENVIRONMENT VARIABLES FOR VERCEL
# ============================================

# Database Connection (Same as backend)
POSTGRES_URL=postgresql://user:password@host:5432/database

# NextAuth Configuration
AUTH_SECRET=generate-a-random-32-character-string-here
NEXTAUTH_URL=https://your-app.vercel.app

# Backend API URL (Will be your Render backend URL)
NEXT_PUBLIC_API_URL=https://sentinal-backend.onrender.com

# Optional: If you need any other public variables
# NEXT_PUBLIC_FEATURE_FLAG=true
