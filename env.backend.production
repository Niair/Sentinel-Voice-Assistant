# ============================================
# BACKEND ENVIRONMENT VARIABLES FOR RENDER
# ============================================

# Server Configuration
PORT=10000
SECRET_KEY=your-super-secret-key-change-this-in-production

# Database (Will be auto-filled by Render PostgreSQL)
POSTGRES_URL=${DATABASE_URL}

# API Keys (ADD YOUR KEYS HERE)
GEMINI_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=
WHISPER_API_KEY=
DEEPSEEK_API_KEY=
NVEDIAKIMIK2_API_KEY=

# LangChain Tracing (Optional but recommended)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=sentinel-production

# Qdrant Vector Store (Get from Qdrant Cloud)
QDRANT_URL=
QDRANT_API_KEY=

# Monitoring System
EVENT_BUS_TYPE=in_process
MONITORING_DEFAULT_MODE=PASSIVE

# Camera/Vision Settings
CAMERA_DEVICE_ID=0
CAMERA_FPS=2
VISION_CONFIDENCE_THRESHOLD=0.6
VISION_MODEL=yolov8n

# Storage
ALERT_FRAME_STORAGE=local
